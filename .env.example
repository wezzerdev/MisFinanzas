# ==============================================================================
# 1. SUPABASE POSTGRESQL (Requerido para Prisma en Local y Dokploy)
# ==============================================================================
# En tu panel de Supabase ve a: Connect (arriba) -> ORM -> Prisma
# Reemplaza [YOUR-PASSWORD], [PROJECT-REF] y la región por los de tu proyecto:

# Transaction Pooler (Puerto 6543 - Usado por la app en producción)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session Pooler / Conexión Directa (Puerto 5432 - Usado por Prisma para migraciones/db push)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ==============================================================================
# 2. URL BASE DE PRODUCCIÓN (Para enlaces de verificación en correos)
# ==============================================================================
NEXT_PUBLIC_APP_URL="https://finanzas.nocodepy.com"

# ==============================================================================
# 3. ENVÍO DE CORREOS ELECTRÓNICOS (SMTP / GMAIL / RESEND)
# ==============================================================================
# OPCIÓN A: GMAIL (Recomendado - Gratis y rápido)
# Genera tu contraseña de aplicación en: https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="tu-correo@gmail.com"
SMTP_PASS="abcd efgh ijkl mnop"
SMTP_FROM="\"Bóveda Finanzas\" <tu-correo@gmail.com>"

# OPCIÓN B: RESEND API (https://resend.com)
# RESEND_API_KEY="re_123456789"
# RESEND_FROM="Bóveda Finanzas <onboarding@resend.dev>"

# ==============================================================================
# 4. SERVICIO OPCIONAL DE IA / OCR (Ollama)
# ==============================================================================
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_VISION_MODEL="llava"
